class Solution:
    def isValidSudoku(self, board: list[list[str]]) -> bool:
        # 1. Kiểm tra hàng ngang và hàng dọc
        for i in range(9):
            row_check = set()
            col_check = set()
            for j in range(9):
                # Kiểm tra hàng i
                if board[i][j] != '.':
                    if board[i][j] in row_check:
                        return False
                    row_check.add(board[i][j])
                
                # Kiểm tra cột i
                if board[j][i] != '.':
                    if board[j][i] in col_check:
                        return False
                    col_check.add(board[j][i])

        # 2. Kiểm tra vùng 3x3
        for r in range(0, 9, 3):
            for c in range(0, 9, 3):
                box_check = set()
                for i in range(3):
                    for j in range(3):
                        val = board[r + i][c + j]
                        if val != '.':
                            if val in box_check:
                                return False
                            box_check.add(val)

        return True